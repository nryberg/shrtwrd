# Caddyfile for shrtwrd.com multi-service setup
# Handles reverse proxy and static file serving with automatic HTTPS

# Global options
{
    # Email for Let's Encrypt
    email your-email@example.com

    # Use Let's Encrypt staging for testing (remove for production)
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

    # Admin API (optional, for monitoring)
    admin localhost:2019
}

# shrtwrd.com and its subdomains - Go application
shrtwrd.com, one.shrtwrd.com, two.shrtwrd.com, three.shrtwrd.com, four.shrtwrd.com, five.shrtwrd.com, six.shrtwrd.com {
    # Reverse proxy to shrtwrd Go application
    reverse_proxy shrtwrd:8080

    # Security headers
    header {
        # Enable HSTS
        Strict-Transport-Security max-age=31536000;
        # Prevent MIME type sniffing
        X-Content-Type-Options nosniff
        # Enable XSS filtering
        X-XSS-Protection "1; mode=block"
        # Prevent clickjacking
        X-Frame-Options DENY
    }

    # Logging
    log {
        output file /var/log/caddy/shrtwrd.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}

