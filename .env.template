# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# ================================================================
# REQUIRED CONFIGURATION
# ================================================================

# DigitalOcean Droplet Configuration
# Your droplet's public IP address (e.g., 134.122.45.67)
DROPLET_IP=your.droplet.ip.address

# Your domain name (e.g., myapp.com)
DOMAIN=yourdomain.com

# Your email for Let's Encrypt SSL certificates
EMAIL=your-email@example.com

# Project name (used for directories and containers)
PROJECT_NAME=shrtwrd-platform

# ================================================================
# OPTIONAL CONFIGURATION
# ================================================================

# SSH Configuration
# Path to your SSH private key
# SSH_KEY_PATH=~/.ssh/id_rsa
# SSH user for droplet access
# SSH_USER=root

# Let's Encrypt Configuration
# Production ACME server (default)
# ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Staging server for testing (uncomment to use)
# ACME_CA_STAGING=https://acme-staging-v02.api.letsencrypt.org/directory

# Docker Configuration
# Custom Docker registry (if using private images)
# DOCKER_REGISTRY=registry.example.com
# Image tag to deploy
# DOCKER_TAG=latest

# Application Configuration
# Port for the Go application (default: 8080)
# APP_PORT=8080
# Log level (debug, info, warn, error)
# LOG_LEVEL=info

# Monitoring & Logging
# Enable metrics collection
# ENABLE_METRICS=true
# External monitoring endpoint
# MONITORING_URL=https://monitoring.example.com/webhook

# ================================================================
# EXAMPLES
# ================================================================
#
# DROPLET_IP=134.122.45.67
# DOMAIN=mywordapp.com
# EMAIL=admin@mywordapp.com
# PROJECT_NAME=word-generator-platform
